<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_alquiler_tree" model="ir.ui.view">
        <field name="name">alquilerv2.tree</field>
        <field name="model">alquilerv2.alquiler</field>
        <field name="arch" type="xml">
            <tree>
                <field name="nombre" />
                <field name="cliente_id" />
                <field name="fecha_inicio" />
                <field name="fecha_fin" />
            </tree>
        </field>
    </record>

    <record id="view_alquiler_form" model="ir.ui.view">
        <field name="name">alquilerv2.form</field>
        <field name="model">alquilerv2.alquiler</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="nombre" />
                            <field name="cliente_id" />
                        </group>
                        <group>
                            <field name="fecha_inicio" />
                            <field name="fecha_fin" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Productos alquilados">
                            <field name="lista_lineas">
                                <tree editable="bottom">
                                    <field name="producto_id" domain="[('es_alquilable', '=', True)]"/>
                                    <field name="cantidad" />
                                    <field name="precio" />
                                    <field name="subtotal" readonly="1" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>

    </record>

    <record id="action_alquiler" model="ir.actions.act_window">
        <field name="name">Alquileres</field>
        <field name="res_model">alquilerv2.alquiler</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_alquiler_raiz" name="Alquileres" />

    <menuitem id="menu_alquiler_operaciones" name="Operaciones" parent="menu_alquiler_raiz" />

    <menuitem id="menu_alquiler_lista" name="Todos los Alquileres"
        parent="menu_alquiler_operaciones"
        action="action_alquiler" />
</odoo>