<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View alquiler.reserva View Tree -->
    <record id="view_alquiler_reserva_tree" model="ir.ui.view">
        <field name="name">view.alquiler.reserva.tree</field>
        <field name="model">alquiler.reserva</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View alquiler.reserva form -->
    <record id="view_alquiler_reserva_form" model="ir.ui.view">
        <field name="name">view.alquiler.reserva.form</field>
        <field name="model">alquiler.reserva</field>
        <field name="arch" type="xml">
            <form string="Alquiler Reserva">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View alquiler.reserva search -->
    <record id="view_alquiler_reserva_search" model="ir.ui.view">
        <field name="name">view.alquiler.reserva.search</field>
        <field name="model">alquiler.reserva</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action alquiler.reserva -->
    <record id="action_alquiler_reserva" model="ir.actions.act_window">
        <field name="name">Alquiler Reserva</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">alquiler.reserva</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Alquiler Reserva.
            </p>
        </field>
    </record>

</odoo>
