<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_alquiler_alquiler" model="ir.actions.act_window">
        <field name="name">Alquileres</field>
        <field name="res_model">alquiler.producto</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer registro de alquiler
            </p>
        </field>
    </record>

    <menuitem id="menu_alquiler_root" 
              name="Alquiler de Productos" 
              web_icon="base,static/description/icon.png"/>

    <menuitem id="menu_alquiler_operaciones" 
              name="Operaciones" 
              parent="menu_alquiler_root" 
              sequence="10"/>

    <menuitem id="menu_alquiler_registros" 
              name="Todos los Alquileres" 
              parent="menu_alquiler_operaciones" 
              action="action_alquiler_alquiler" 
              sequence="10"/>
</odoo>