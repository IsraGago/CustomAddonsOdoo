<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View alquiler.producto View List -->
    <record id="view_alquiler_producto_list" model="ir.ui.view">
        <field name="name">view.alquiler.producto.list</field>
        <field name="model">alquiler.producto</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View alquiler.producto form -->
    <record id="view_alquiler_producto_form" model="ir.ui.view">
        <field name="name">view.alquiler.producto.form</field>
        <field name="model">alquiler.producto</field>
        <field name="arch" type="xml">
            <form string="Alquiler Producto">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View alquiler.producto search -->
    <record id="view_alquiler_producto_search" model="ir.ui.view">
        <field name="name">view.alquiler.producto.search</field>
        <field name="model">alquiler.producto</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action alquiler.producto -->
    <record id="action_alquiler_producto" model="ir.actions.act_window">
        <field name="name">Alquiler Producto</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">alquiler.producto</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Alquiler Producto.
            </p>
        </field>
    </record>

</odoo>
